# A .pubignore replaces this package's .gitignore for pub (pub does not merge the
# two), so reproduce the .gitignore exclusions here, unanchored so the nested
# example is also caught, then add the development test trees

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Flutter, Dart, and Pub related
.dart_tool/
.flutter-plugins-dependencies
pubspec.lock
build/
coverage/
doc/api/

# CocoaPods build products from the nested example
Pods/
.symlinks/

# The SDK's own unit tests and integration-test infrastructure are development-only
test/
test_driver/

# The vendored build hook is gone: binaries ship prebuilt

# Codegen configuration a consumer never runs
flutter_rust_bridge.yaml

# pubspec.yaml declares android and ios only
linux/
macos/
windows/

# Keep the example's Dart sources, asset, README, and analysis options so
# pub.dev can render the Example tab, and drop its platform scaffolds and
# integration harness
example/android/
example/ios/
example/linux/
example/macos/
example/windows/
example/integration_test/

# The staging script self-test is development tooling
ios/stage_prebuilt.test.sh

# Maintainer-only tooling to sync the bundled platform scripts from a sibling
# coproduct-platform checkout; irrelevant to a consumer of the package
scripts/
