# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
# The example app's lockfile is a regenerable dev artifact, like every other
# first-party lockfile in this repository, so it is not tracked either.
/pubspec.lock
/example/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/
