{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@coproduct/react-native-sdk": ["./src/index"],
      "@coproduct/react-native-sdk/paywall": ["./src/paywall/index"],
      "@coproduct/react-native-sdk/onboarding": ["./src/onboarding/index"],
      "@coproduct/react-native-sdk/internal": ["./src/internal"]
    },
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "customConditions": ["react-native-strict-api"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitUseStrict": false,
    "noStrictGenericChecks": false,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["jest", "node"],
    "verbatimModuleSyntax": true
  },
  "exclude": ["node_modules", "build", "scripts/readme-context"]
}
