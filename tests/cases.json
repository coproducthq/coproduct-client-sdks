    { "name": "equals/null_lhs_returns_false", "operator": "equals", "lhs": null, "values": [""], "expected": false },

    { "name": "not_equals/string/inverts", "operator": "not_equals", "lhs": "free", "values": ["premium"], "expected": true },
    { "name": "not_equals/string/match", "operator": "not_equals", "lhs": "premium", "values": ["premium"], "expected": false },
    { "name": "not_equals/empty/false", "operator": "not_equals", "lhs": "any", "values": [], "expected": false },

