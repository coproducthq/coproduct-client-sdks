{
  "comment": "Shared cross-SDK conformance corpus. Cases are namespaced by category so the Rust, Swift, Android, Flutter, and React Native runners can read the same file without schema drift: each runner parses the root object and consumes only its own array. Within operator_cases, rule values are JSON strings matching the platform value schema, which is a list of strings. Numeric operators parse the strings, semver operators parse them as semantic versions, and string operators use them directly.",
  "operator_cases": [
    { "name": "equals/string/match", "operator": "equals", "lhs": "premium", "values": ["premium"], "expected": true },
    { "name": "equals/string/miss", "operator": "equals", "lhs": "free", "values": ["premium"], "expected": false },
    { "name": "equals/number_attr_via_stringify", "operator": "equals", "lhs": 42, "values": ["42"], "expected": true },
    { "name": "equals/number_decimal_via_stringify", "operator": "equals", "lhs": 3.14, "values": ["3.14"], "expected": true },
