#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# CocoaPods (Flutter iOS uses pods, not a vendored framework)
ios/Pods/
ios/Podfile.lock
ios/.symlinks/
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh

# Gradle / Kotlin caches
android/.gradle/
android/.kotlin/
android/local.properties

# Pubspec lockfile — regenerated per-toolchain; reproducibility comes from SDK source pin
pubspec.lock
